# =============================================================================
# PhotoIntel Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# ---------------------------------------------------------------------------
# Storage Paths
# ---------------------------------------------------------------------------
# Root directories the scanner will search for images (comma-separated).
PHOTOINTEL_SCAN_ROOTS=~/Pictures

# Managed workspace for derivatives, vector DB, metadata, and caches.
# This is the only directory PhotoIntel writes to.
PHOTOINTEL_VAULT_ROOT=~/.photointel

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PHOTOINTEL_HOST=127.0.0.1
PHOTOINTEL_PORT=5000
PHOTOINTEL_WORKERS=4
PHOTOINTEL_MAX_UPLOAD_MB=128
PHOTOINTEL_SECRET_KEY=change-me-to-a-random-string

# ---------------------------------------------------------------------------
# Vector Database (Qdrant)
# ---------------------------------------------------------------------------
# Provider: "qdrant_local" (embedded, recommended) or "qdrant_remote"
PHOTOINTEL_VECTOR_PROVIDER=qdrant_local
# Only used when provider is qdrant_remote:
PHOTOINTEL_QDRANT_HOST=localhost
PHOTOINTEL_QDRANT_PORT=6333
# Collection names
PHOTOINTEL_QDRANT_SCENE_COLLECTION=scene_embeddings
PHOTOINTEL_QDRANT_REGION_COLLECTION=region_embeddings

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Object detection
PHOTOINTEL_DETECTOR_MODEL=yolov8m.pt
PHOTOINTEL_DETECTOR_CONFIDENCE_PERSON=0.50
PHOTOINTEL_DETECTOR_CONFIDENCE_ANIMAL=0.40
PHOTOINTEL_DETECTOR_CONFIDENCE_GENERAL=0.25

# Image/text embeddings (CLIP)
PHOTOINTEL_EMBEDDING_MODEL=openai/clip-vit-large-patch14
PHOTOINTEL_EMBEDDING_DIM=768
PHOTOINTEL_EMBEDDING_DEVICE=auto

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
PHOTOINTEL_ENABLE_SCENE_EMBEDDINGS=true
PHOTOINTEL_ENABLE_REGION_EMBEDDINGS=true
PHOTOINTEL_ENABLE_EXIF_GPS=true
PHOTOINTEL_ENABLE_UPLOAD=true
PHOTOINTEL_ENABLE_ACTIVE_LEARNING=true

# ---------------------------------------------------------------------------
# Background Jobs
# ---------------------------------------------------------------------------
PHOTOINTEL_SCAN_ON_STARTUP=false
PHOTOINTEL_INDEX_BATCH_SIZE=32
PHOTOINTEL_BACKGROUND_WORKERS=2

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
PHOTOINTEL_LOG_LEVEL=INFO
